/* ============================================================
   Lens — layout.css
   App-specific styles: tab bar, pick button, history grid,
   palettes split view, settings, loupe window.
   Matches the suite structure: .app > TitleBar + .lens-stage
   ============================================================ */

/* ---------- App shell ---------- */

.app {
  display: flex;
  flex-direction: column;
  height: 100%;
}

/* ---------- Stage ---------- */

.lens-stage {
  flex: 1;
  position: relative;
  overflow: hidden;
  background: var(--bg-stage);
  display: flex;
  flex-direction: column;
}

/* ---------- Tab bar ---------- */

.lens-tabs {
  display: flex;
  gap: 2px;
  padding: 8px 12px 0;
  background: var(--bg);
  border-bottom: var(--border-w) solid var(--border);
  flex-shrink: 0;
}

.lens-tabs__btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 7px 14px;
  font-size: 12.5px;
  font-weight: 600;
  color: var(--text-2);
  background: transparent;
  border: none;
  border-bottom: 2px solid transparent;
  cursor: pointer;
  transition: color 140ms var(--ease-out-expo), border-color 140ms var(--ease-out-expo);
}

.lens-tabs__btn:hover:not(.lens-tabs__btn--active) {
  color: var(--text-1);
}

.lens-tabs__btn--active {
  color: var(--text-1);
  border-bottom-color: var(--ink);
}

.lens-tabs__btn svg {
  width: 14px;
  height: 14px;
}

/* ---------- Pick bar ---------- */

.lens-pick-bar {
  padding: 12px 16px;
  background: var(--bg);
  border-bottom: var(--border-w) solid var(--border);
  flex-shrink: 0;
}

/* ---------- Content area ---------- */

.lens-content {
  flex: 1;
  overflow-y: auto;
  background: var(--bg);
}

/* ---------- History ---------- */

.lens-history {
  padding: 16px;
}

.lens-history__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}

.lens-history__count {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--text-3);
}

.lens-history__grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
  gap: 8px;
}

/* ---------- Color swatch ---------- */

.color-swatch {
  display: flex;
  flex-direction: column;
  gap: 0;
  background: var(--bg-subtle);
  border: var(--border-w) solid var(--border);
  border-radius: var(--radius-sm);
  overflow: hidden;
  cursor: pointer;
  transition: border-color 140ms var(--ease-out-expo);
}

.color-swatch:hover {
  border-color: var(--border-mid);
}

.color-swatch__color {
  width: 100%;
  height: 48px;
  flex-shrink: 0;
}

.color-swatch__body {
  padding: 6px 8px;
  display: flex;
  flex-direction: column;
  gap: 1px;
}

.color-swatch__hex {
  font-size: 12px;
  font-weight: 700;
  color: var(--text-1);
  font-family: var(--mono);
}

.color-swatch__format {
  font-size: 10.5px;
  color: var(--text-3);
  font-family: var(--mono);
}

.color-swatch__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  padding: 4px 8px 8px;
}

/* ---------- Palettes ---------- */

.lens-palettes {
  display: flex;
  height: 100%;
  overflow: hidden;
}

.lens-palettes__sidebar {
  width: 140px;
  min-width: 140px;
  border-right: var(--border-w) solid var(--border);
  padding: 12px 8px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.lens-palettes__item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 10px;
  border-radius: var(--radius-sm);
  border: var(--border-w) solid transparent;
  background: transparent;
  cursor: pointer;
  text-align: left;
  width: 100%;
  transition: background-color 140ms var(--ease-out-expo), border-color 140ms var(--ease-out-expo);
}

.lens-palettes__item:hover {
  background: var(--bg-hover);
}

.lens-palettes__item--active {
  background: var(--bg-hover);
  border-color: var(--border-mid);
}

.lens-palettes__item-name {
  font-size: 12.5px;
  font-weight: 600;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lens-palettes__item-count {
  font-size: 11px;
  color: var(--text-3);
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}

.lens-palettes__detail {
  flex: 1;
  overflow-y: auto;
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.lens-palettes__detail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.lens-palettes__detail-name {
  font-size: 15px;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: -0.01em;
}

.lens-palettes__detail-actions {
  display: flex;
  gap: 4px;
  flex-wrap: wrap;
}

.lens-palettes__colors {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
  gap: 8px;
}

.lens-palettes__quick-add {
  border-top: var(--border-w) solid var(--border);
  padding-top: 12px;
}

.lens-palettes__quick-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(24px, 1fr));
  gap: 4px;
}

.lens-palettes__quick-swatch {
  width: 100%;
  aspect-ratio: 1;
  border-radius: var(--radius-sm);
  border: var(--border-w) solid var(--border);
  cursor: pointer;
  padding: 0;
  transition: transform 140ms var(--ease-out-expo);
}

.lens-palettes__quick-swatch:hover {
  transform: scale(1.1);
}

/* ---------- Settings ---------- */

.lens-settings {
  padding: 20px 16px;
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.lens-settings__section {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.lens-settings__hint {
  font-size: 11.5px;
  color: var(--text-3);
  line-height: 1.5;
}

/* ---------- Loupe window ---------- */

.loupe {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  height: 100%;
  background: var(--bg);
  border-radius: var(--radius-md);
  border: var(--border-w) solid var(--border);
  overflow: hidden;
  cursor: crosshair;
  user-select: none;
}

.loupe-loading {
  width: 100%;
  height: 100%;
  background: var(--bg);
}

.loupe__canvas-wrap {
  position: relative;
  width: 120px;
  height: 120px;
  flex-shrink: 0;
}

.loupe__canvas {
  display: block;
  width: 120px;
  height: 120px;
}

.loupe__crosshair {
  position: absolute;
  background: rgba(255, 255, 255, 0.6);
  pointer-events: none;
  mix-blend-mode: difference;
}

.loupe__crosshair--h {
  left: 0;
  right: 0;
  top: 50%;
  height: 1px;
}

.loupe__crosshair--v {
  top: 0;
  bottom: 0;
  left: 50%;
  width: 1px;
}

.loupe__center-box {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 8px;
  height: 8px;
  transform: translate(-50%, -50%);
  border: 1.5px solid #fff;
  box-shadow: 0 0 0 1px #000;
  pointer-events: none;
}

.loupe__readout {
  width: 100%;
  padding: 4px 0;
  text-align: center;
  flex-shrink: 0;
}

.loupe__hex {
  font-size: 12px;
  font-weight: 700;
  font-family: var(--mono);
  letter-spacing: 0.02em;
}

.loupe__hint {
  font-size: 9px;
  color: var(--text-3);
  padding: 2px 0 4px;
  text-align: center;
  flex-shrink: 0;
}

