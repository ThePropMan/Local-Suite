/* ============================================================
   Vector — layout.css
   App-specific styles: home screen, working view (file list,
   preview, controls), advanced controls, export bar.
   Matches Folio/Veil/Mark structure: .app > TitleBar + .stage
   ============================================================ */

/* ---------- App shell ---------- */

.app {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.stage {
  flex: 1;
  position: relative;
  overflow: hidden;
  background: var(--bg-stage);
  display: flex;
  flex-direction: column;
}

/* ---------- Drop overlay (home) ---------- */

.drop-overlay {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20px;
  padding: 40px;
}

.vector-logo {
  font-family: var(--mono);
  font-size: 13px;
  line-height: 1.25;
  font-weight: 400;
  font-synthesis: none;
  color: var(--text-1);
  margin: 0;
  user-select: none;
  letter-spacing: 0;
}

.drop-overlay__presets-hint {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 11px;
  color: var(--text-3);
}

.drop-overlay__recent {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  width: 100%;
  max-width: 420px;
}

.drop-overlay__recent-label {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--text-3);
  align-self: flex-start;
  padding-left: 10px;
}

/* ---------- Working view (3-column) ---------- */

.vector-work {
  flex: 1;
  display: flex;
  overflow: hidden;
  background: var(--bg);
}

/* ---------- File list (left) ---------- */

.vector-files {
  width: 240px;
  min-width: 240px;
  border-right: var(--border-w) solid var(--border);
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

.vector-files__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 14px 8px;
}

.vector-files__list {
  flex: 1;
  overflow-y: auto;
  padding: 0 10px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.vector-files__clear {
  padding: 10px 14px;
  border-top: var(--border-w) solid var(--border);
  color: var(--text-3);
  font-size: 11px;
  display: flex;
  align-items: center;
  gap: 6px;
}

.vector-files__clear:hover {
  color: var(--danger);
}

/* ---------- Preview area (center) ---------- */

.vector-preview-area {
  flex: 1;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background: var(--bg-stage);
  min-width: 0;
}

.vector-preview {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.vector-preview__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 18px;
  border-bottom: var(--border-w) solid var(--border);
  background: var(--bg);
  flex-shrink: 0;
}

.vector-preview__title {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  font-weight: 600;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.vector-preview__actions {
  display: flex;
  align-items: center;
  gap: 4px;
}

.btn-ghost--active {
  color: var(--text-1);
  background: var(--bg-hover);
}

.vector-preview__canvas {
  flex: 1;
  overflow: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: var(--bg-stage);
  background-image:
    linear-gradient(45deg, var(--bg-subtle) 25%, transparent 25%),
    linear-gradient(-45deg, var(--bg-subtle) 25%, transparent 25%),
    linear-gradient(45deg, transparent 75%, var(--bg-subtle) 75%),
    linear-gradient(-45deg, transparent 75%, var(--bg-subtle) 75%);
  background-size: 20px 20px;
  background-position: 0 0, 0 10px, 10px -10px, -10px 0;
}

.vector-preview__img,
.vector-preview__svg {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
  border-radius: var(--radius-sm);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
}

.vector-preview__svg {
  background: var(--bg);
}

.vector-preview__loading,
.vector-preview__error {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  color: var(--text-3);
  font-size: 13px;
}

.vector-preview__loading svg {
  animation: spin 1.4s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.vector-preview__error {
  color: var(--danger);
}

.vector-preview__meta {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 10px 18px;
  border-top: var(--border-w) solid var(--border);
  background: var(--bg);
  font-size: 11px;
  color: var(--text-3);
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}

.vector-preview__meta strong {
  color: var(--text-1);
  font-weight: 600;
}

.vector-preview__meta button {
  margin-left: auto;
}

/* ---------- Controls (right) ---------- */

.vector-controls {
  width: 280px;
  min-width: 280px;
  border-left: var(--border-w) solid var(--border);
  display: flex;
  flex-direction: column;
  overflow-y: auto;
  background: var(--bg);
}

.vector-controls__section {
  padding: 14px 16px;
  border-bottom: var(--border-w) solid var(--border);
}

.vector-controls__label {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--text-3);
  margin-bottom: 8px;
}

.vector-presets {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px;
}

.vector-presets .preset {
  padding: 8px;
}

.vector-presets .preset__label {
  font-size: 12px;
}

.vector-presets .preset__desc {
  font-size: 10px;
  line-height: 1.3;
}

/* ---------- Advanced controls ---------- */

.vector-advanced__toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 0;
  background: none;
  border: none;
  cursor: pointer;
  color: var(--text-3);
}

.vector-advanced {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 10px;
}

.vector-advanced__row {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.vector-advanced__label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 11px;
  font-weight: 500;
  color: var(--text-2);
}

.vector-advanced__value {
  font-family: var(--mono);
  font-size: 11px;
  color: var(--text-1);
  font-variant-numeric: tabular-nums;
}

.vector-advanced input[type="range"] {
  width: 100%;
  accent-color: var(--ink);
}

.vector-advanced .preset-group .preset {
  padding: 6px;
}

.vector-advanced .preset-group .preset__label {
  font-size: 11px;
}

/* ---------- Export bar ---------- */

.vector-exportbar {
  margin-top: auto;
  padding: 14px 16px;
  border-top: var(--border-w) solid var(--border);
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.vector-exportbar__output {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.vector-exportbar__output-row {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
}

.vector-exportbar__path {
  font-size: 10px;
  color: var(--text-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 120px;
  font-family: var(--mono);
}

.vector-exportbar__buttons {
  display: flex;
  gap: 8px;
}

.vector-exportbar__buttons .btn {
  flex: 1;
}

/* ---------- Settings overlay ---------- */

.settings-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.3);
  z-index: 200;
  display: flex;
  justify-content: flex-end;
  animation: fade-in 140ms var(--ease-out-expo);
}

@keyframes fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

.settings-overlay__panel {
  width: 300px;
  height: 100%;
  background: var(--bg);
  border-left: var(--border-w) solid var(--border);
  display: flex;
  flex-direction: column;
  box-shadow: -4px 0 24px rgba(0, 0, 0, 0.08);
}

.settings-overlay__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 16px;
  border-bottom: var(--border-w) solid var(--border);
  font-size: 14px;
  font-weight: 700;
  color: var(--text-1);
}

.settings-overlay__body {
  flex: 1;
  overflow-y: auto;
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.settings-overlay__section {
  display: flex;
  flex-direction: column;
}

.muted {
  font-size: 11px;
  color: var(--text-4);
}
