// ============================================================
// Shred — commands/shred.rs
// Secure file deletion: overwrite N passes then delete.
// Algorithms: Quick (1-pass random), DoD 5220.22-M (3-pass),
// Gutmann (35-pass), Custom (N passes, configurable pattern).
// Free-space wipe, SSD detection, post-shred verification,
// and a local JSON log of operations.
// ============================================================

use std::fs;
use std::io::{Read, Write, Seek, SeekFrom, BufWriter};
use std::path::{Path, PathBuf};
use std::time::{Instant, SystemTime, UNIX_EPOCH};

use rand::RngCore;
use serde::{Deserialize, Serialize};
use walkdir::WalkDir;

// ---------- Algorithms ----------

#[derive(Clone, Copy, Serialize, Deserialize, PartialEq, Eq)]
#[serde(rename_all = "kebab-case")]
pub enum Algorithm {
    Quick,
    Dod,
    Gutmann,
    Custom,
}

impl Algorithm {
    fn passes(&self, custom_passes: u32) -> u32 {
        match self {
            Algorithm::Quick => 1,
            Algorithm::Dod => 3,
            Algorithm::Gutmann => 35,
            Algorithm::Custom => custom_passes.max(1),
        }
    }

    fn name(&self) -> &'static str {
        match self {
            Algorithm::Quick => "Quick (1-pass random)",
            Algorithm::Dod => "DoD 5220.22-M (3-pass)",
            Algorithm::Gutmann => "Gutmann (35-pass)",
            Algorithm::Custom => "Custom",
        }
    }
}

/// Returns the byte pattern for a given pass index (0-based) under
/// the chosen algorithm. `None` means "write random data".
fn pass_pattern(algo: &Algorithm, pass_index: u32, custom_pattern: Option<u8>) -> Option<u8> {
    match algo {
        Algorithm::Quick => None, // all random
        Algorithm::Dod => match pass_index {
            0 => Some(0x00),
            1 => Some(0xFF),
            2 => None, // random verify pass
            _ => None,
        },
        Algorithm::Gutmann => {
            // Gutmann's 35 passes: patterns from the original paper.
            // Passes 0-3 and 31-34 are random; 4-30 are fixed patterns.
            match pass_index {
                0..=3 | 31..=34 => None,
                4 | 19 => Some(0x55),
                5 | 20 => Some(0xAA),
                6..=18 if (pass_index - 6) % 3 == 0 => Some(0x92),
                6..=18 if (pass_index - 6) % 3 == 1 => Some(0x49),
                6..=18 if (pass_index - 6) % 3 == 2 => Some(0x24),
                21..=30 if (pass_index - 21) % 3 == 0 => Some(0x6D),
                21..=30 if (pass_index - 21) % 3 == 1 => Some(0xB6),
                21..=30 if (pass_index - 21) % 3 == 2 => Some(0xDB),
                _ => None,
            }
        }
        Algorithm::Custom => custom_pattern,
    }
}

// ---------- Result types ----------

#[derive(Serialize, Deserialize)]
pub struct ShredResult {
    pub files_shredded: u64,
    pub files_skipped: u64,
    pub bytes_overwritten: u64,
    pub duration_ms: u64,
    pub algorithm: String,
    pub passes: u32,
    pub verified: bool,
    pub errors: Vec<String>,
}

#[derive(Serialize, Deserialize)]
pub struct FileProgress {
    pub current_file: u32,
    pub total_files: u32,
    pub file_name: String,
    pub pass: u32,
    pub total_passes: u32,
    pub file_percent: u32,
    pub overall_percent: u32,
}

#[derive(Serialize, Deserialize)]
pub struct WipeResult {
    pub bytes_wiped: u64,
    pub duration_ms: u64,
    pub drive: String,
    pub errors: Vec<String>,
}

#[derive(Serialize, Deserialize)]
pub struct DriveInfo {
    pub letter: String,
    pub label: String,
    pub is_ssd: bool,
    pub total_bytes: u64,
    pub free_bytes: u64,
}

#[derive(Serialize, Deserialize, Clone)]
pub struct LogEntry {
    pub timestamp: u64,
    pub action: String,
    pub algorithm: String,
    pub passes: u32,
    pub files: u64,
    pub bytes: u64,
    pub duration_ms: u64,
    pub verified: bool,
    pub paths: Vec<String>,
}

// ---------- Main shred command ----------

/// Shred a list of files and/or folders. Overwrites each file with
/// the chosen algorithm's passes, then deletes it. Emits
/// `shred://progress` events as it works.
#[tauri::command]
pub fn shred_files(
    app: tauri::AppHandle,
    paths: Vec<String>,
    algorithm: Algorithm,
    custom_passes: Option<u32>,
    custom_pattern: Option<u8>,
    verify: bool,
) -> Result<ShredResult, String> {
    let start = Instant::now();
    let passes = algorithm.passes(custom_passes.unwrap_or(1));

    // Expand folders into a flat list of files.
    let file_list = expand_paths(&paths)?;
    let total_files = file_list.len() as u32;
    if total_files == 0 {
        return Err("No files to shred.".to_string());
    }

    let mut files_shredded = 0u64;
    let mut files_skipped = 0u64;
    let mut bytes_overwritten = 0u64;
    let mut errors = Vec::new();
    let mut all_verified = true;

    for (i, file_path) in file_list.iter().enumerate() {
        let file_name = file_path
            .file_name()
            .and_then(|n| n.to_str())
            .unwrap_or("(unknown)")
            .to_string();

        // Emit progress: starting this file.
        let _ = app.emit(
            "shred://progress",
            FileProgress {
                current_file: i as u32 + 1,
                total_files,
                file_name: file_name.clone(),
                pass: 0,
                total_passes: passes,
                file_percent: 0,
                overall_percent: ((i as u64 * 100) / total_files as u64) as u32,
            },
        );

        match shred_single_file(file_path, algorithm, passes, custom_pattern, &app, i as u32, total_files) {
            Ok(bytes) => {
                bytes_overwritten += bytes;
                if verify {
                    match verify_deleted(file_path) {
                        Ok(true) => {}
                        Ok(false) => {
                            all_verified = false;
                            errors.push(format!("Verification failed: {} still readable", file_path.display()));
                        }
                        Err(e) => {
                            all_verified = false;
                            errors.push(format!("Verification error for {}: {e}", file_path.display()));
                        }
                    }
                }
                files_shredded += 1;
            }
            Err(e) => {
                files_skipped += 1;
                errors.push(format!("Failed to shred {}: {e}", file_path.display()));
            }
        }
    }

    // Remove now-empty directories (best-effort).
    remove_empty_dirs(&paths);

    let duration_ms = start.elapsed().as_millis() as u64;

    // Append to the shred log.
    let log_entry = LogEntry {
        timestamp: SystemTime::now()
            .duration_since(UNIX_EPOCH)
            .unwrap_or_default()
            .as_secs(),
        action: "shred".to_string(),
        algorithm: algorithm.name().to_string(),
        passes,
        files: files_shredded,
        bytes: bytes_overwritten,
        duration_ms,
        verified: verify && all_verified,
        paths: paths.clone(),
    };
    let _ = append_log(&app, &log_entry);

    Ok(ShredResult {
        files_shredded,
        files_skipped,
        bytes_overwritten,
        duration_ms,
        algorithm: algorithm.name().to_string(),
        passes,
        verified: verify && all_verified,
        errors,
    })
}

/// Overwrite a single file with `passes` passes, then delete it.
/// Returns the number of bytes written (per pass × passes).
fn shred_single_file(
    path: &Path,
    algorithm: Algorithm,
    passes: u32,
    custom_pattern: Option<u8>,
    app: &tauri::AppHandle,
    file_index: u32,
    total_files: u32,
) -> Result<u64, String> {
    let file_name = path
        .file_name()
        .and_then(|n| n.to_str())
        .unwrap_or("(unknown)")
        .to_string();

    // Get file size before opening for write.
    let size = fs::metadata(path)
        .map_err(|e| format!("Cannot stat file: {e}"))?
        .len();

    if size == 0 {
        // Empty file — just delete it.
        fs::remove_file(path).map_err(|e| format!("Delete failed: {e}"))?;
        return Ok(0);
    }

    let mut total_written = 0u64;

    for pass in 0..passes {
        let pattern = pass_pattern(&algorithm, pass, custom_pattern);

        // Open file in write mode (truncate existing content).
        let file = fs::OpenOptions::new()
            .write(true)
            .truncate(true)
            .open(path)
            .map_err(|e| format!("Cannot open for write: {e}"))?;

        let mut writer = BufWriter::with_capacity(256 * 1024, file);
        let chunk_size = 256 * 1024usize;
        let mut chunk = vec![0u8; chunk_size];

        if let Some(byte) = pattern {
            // Fixed pattern pass — fill chunk with the byte.
            chunk.iter_mut().for_each(|b| *b = byte);
        }

        let mut written = 0u64;
        while written < size {
            let to_write = std::cmp::min(chunk_size as u64, size - written) as usize;
            if pattern.is_none() {
                // Random pass — fill the chunk we'll write with fresh random bytes.
                rand::thread_rng().fill_bytes(&mut chunk[..to_write]);
            }
            writer
                .write_all(&chunk[..to_write])
                .map_err(|e| format!("Write failed on pass {}: {e}", pass + 1))?;
            written += to_write as u64;

            // Emit progress for this pass.
            let file_percent = ((written as u64 * 100) / size) as u32;
            let overall_base = (file_index as u64 * 100) / total_files as u64;
            let overall_fraction = ((file_index as u64 + 1) * 100) / total_files as u64;
            let pass_fraction = (pass as u64 * 100 + file_percent as u64) / passes as u64;
            let overall_percent = (overall_base + (overall_fraction - overall_base) * pass_fraction / 100) as u32;
            let _ = app.emit(
                "shred://progress",
                FileProgress {
                    current_file: file_index + 1,
                    total_files,
                    file_name: file_name.clone(),
                    pass: pass + 1,
                    total_passes: passes,
                    file_percent,
                    overall_percent,
                },
            );
        }

        // Flush + sync to force the data to disk before the next pass.
        writer
            .flush()
            .map_err(|e| format!("Flush failed on pass {}: {e}", pass + 1))?;
        let inner = writer.into_inner().map_err(|e| format!("Buffer error: {e}"))?;
        inner
            .sync_all()
            .map_err(|e| format!("Sync failed on pass {}: {e}", pass + 1))?;

        total_written += written;
    }

    // Final: delete the file.
    fs::remove_file(path).map_err(|e| format!("Delete failed: {e}"))?;

    Ok(total_written)
}

/// Attempt to open the file — if it succeeds, the file was not deleted.
fn verify_deleted(path: &Path) -> Result<bool, String> {
    match fs::File::open(path) {
        Ok(_) => Ok(false),
        Err(_) => Ok(true),
    }
}

// ---------- Free-space wipe ----------

/// Overwrite all free space on a drive by creating a large temp file
/// and filling it with random data, then deleting it.
#[tauri::command]
pub fn wipe_free_space(
    app: tauri::AppHandle,
    drive: String,
) -> Result<WipeResult, String> {
    let start = Instant::now();
    let drive_root = if drive.ends_with('\\') || drive.ends_with('/') {
        drive.clone()
    } else {
        format!("{drive}\\")
    };

    // Verify the drive exists.
    let drive_path = Path::new(&drive_root);
    if !drive_path.exists() {
        return Err(format!("Drive {drive} does not exist"));
    }

    let temp_dir = std::env::temp_dir();
    // Prefer the target drive's temp location so we actually wipe its free space.
    let wipe_dir = Path::new(&drive_root).join(".shred-wipe-tmp");
    fs::create_dir_all(&wipe_dir)
        .map_err(|e| format!("Cannot create temp dir on {drive}: {e}"))?;

    let temp_path = wipe_dir.join("wipefile.tmp");
    let mut bytes_wiped = 0u64;
    let mut errors = Vec::new();

    // Create the file and keep growing it until the disk is full.
    let file = match fs::OpenOptions::new()
        .create(true)
        .write(true)
        .truncate(true)
        .open(&temp_path)
    {
        Ok(f) => f,
        Err(e) => {
            let _ = fs::remove_dir_all(&wipe_dir);
            return Err(format!("Cannot create wipe file: {e}"));
        }
    };

    let mut writer = BufWriter::with_capacity(1024 * 1024, file);
    let chunk_size = 1024 * 1024usize; // 1 MB chunks
    let mut chunk = vec![0u8; chunk_size];

    // Fill with random data until disk-full.
    loop {
        rand::thread_rng().fill_bytes(&mut chunk);
        match writer.write_all(&chunk) {
            Ok(_) => {
                bytes_wiped += chunk_size as u64;
                let _ = app.emit(
                    "shred://wipe-progress",
                    serde_json::json!({ "bytes": bytes_wiped }),
                );
            }
            Err(e) => {
                // Disk full is expected — break out.
                if e.kind() == std::io::ErrorKind::Other
                    || e.to_string().contains("No space")
                    || e.raw_os_error() == Some(28) // ENOSPC on Unix
                    || e.raw_os_error() == Some(39) // ERROR_HANDLE_DISK_FULL on Windows
                    || e.raw_os_error() == Some(112) // ERROR_DISK_FULL on Windows
                {
                    break;
                }
                errors.push(format!("Write error during wipe: {e}"));
                break;
            }
        }
    }

    // Flush + sync, then delete.
    let _ = writer.flush();
    let _ = writer.into_inner().and_then(|f| f.sync_all());
    let _ = fs::remove_file(&temp_path);
    let _ = fs::remove_dir_all(&wipe_dir);

    // Also touch the temp_dir path if it was on the system drive —
    // the temp_dir wipe file may have been created there by std::env::temp_dir().
    let _ = fs::remove_file(temp_dir.join("wipefile.tmp"));

    let duration_ms = start.elapsed().as_millis() as u64;

    // Log the wipe.
    let log_entry = LogEntry {
        timestamp: SystemTime::now()
            .duration_since(UNIX_EPOCH)
            .unwrap_or_default()
            .as_secs(),
        action: "wipe".to_string(),
        algorithm: "Free-space wipe (random)".to_string(),
        passes: 1,
        files: 0,
        bytes: bytes_wiped,
        duration_ms,
        verified: false,
        paths: vec![drive.clone()],
    };
    let _ = append_log(&app, &log_entry);

    Ok(WipeResult {
        bytes_wiped,
        duration_ms,
        drive,
        errors,
    })
}

// ---------- SSD detection ----------

/// Detect whether the drive containing the given path is an SSD.
/// On Windows, uses DeviceIoControl to query the storage device's
/// rotation rate. On other platforms, returns false (unknown).
#[tauri::command]
pub fn detect_ssd(path: String) -> Result<bool, String> {
    #[cfg(target_os = "windows")]
    {
        detect_ssd_windows(&path)
    }
    #[cfg(not(target_os = "windows"))]
    {
        let _ = path;
        Ok(false)
    }
}

/// List all fixed drives with SSD detection and free/total space.
#[tauri::command]
pub fn list_drives() -> Result<Vec<DriveInfo>, String> {
    let mut drives = Vec::new();

    #[cfg(target_os = "windows")]
    {
        for letter in b'A'..=b'Z' {
            let root = format!("{}:\\", letter as char);
            let root_path = Path::new(&root);
            if !root_path.exists() {
                continue;
            }
            // Skip floppy / non-fixed drives.
            if root.starts_with("A:\\") || root.starts_with("B:\\") {
                continue;
            }

            let (total, free) = drive_space(&root).unwrap_or((0, 0));
            let is_ssd = detect_ssd_windows(&root).unwrap_or(false);
            let label = volume_label(&root).unwrap_or_default();

            drives.push(DriveInfo {
                letter: format!("{}:", letter as char),
                label,
                is_ssd,
                total_bytes: total,
                free_bytes: free,
            });
        }
    }

    #[cfg(not(target_os = "windows"))]
    {
        // On non-Windows, list "/" as the only drive.
        let (total, free) = drive_space("/").unwrap_or((0, 0));
        drives.push(DriveInfo {
            letter: "/".to_string(),
            label: "Root".to_string(),
            is_ssd: false,
            total_bytes: total,
            free_bytes: free,
        });
    }

    Ok(drives)
}

// ---------- Shred log ----------

/// Read the local shred log (JSON array of LogEntry).
#[tauri::command]
pub fn read_shred_log(app: tauri::AppHandle) -> Result<Vec<LogEntry>, String> {
    let log_path = log_path(&app)?;
    if !log_path.exists() {
        return Ok(Vec::new());
    }
    let data = fs::read_to_string(&log_path)
        .map_err(|e| format!("Cannot read log: {e}"))?;
    serde_json::from_str(&data).map_err(|e| format!("Cannot parse log: {e}"))
}

/// Clear the shred log.
#[tauri::command]
pub fn clear_shred_log(app: tauri::AppHandle) -> Result<(), String> {
    let log_path = log_path(&app)?;
    if log_path.exists() {
        fs::remove_file(&log_path).map_err(|e| format!("Cannot clear log: {e}"))?;
    }
    Ok(())
}

fn log_path(app: &tauri::AppHandle) -> Result<PathBuf, String> {
    let dir = app
        .path()
        .app_data_dir()
        .map_err(|e| format!("Cannot resolve app data dir: {e}"))?;
    fs::create_dir_all(&dir).map_err(|e| format!("Cannot create app data dir: {e}"))?;
    Ok(dir.join("shred-log.json"))
}

fn append_log(app: &tauri::AppHandle, entry: &LogEntry) -> Result<(), String> {
    let path = log_path(app)?;
    let mut existing: Vec<LogEntry> = if path.exists() {
        fs::read_to_string(&path)
            .ok()
            .and_then(|s| serde_json::from_str(&s).ok())
            .unwrap_or_default()
    } else {
        Vec::new()
    };
    // Keep the most recent 200 entries.
    existing.insert(0, entry.clone());
    if existing.len() > 200 {
        existing.truncate(200);
    }
    let json = serde_json::to_string_pretty(&existing)
        .map_err(|e| format!("Cannot serialize log: {e}"))?;
    fs::write(&path, json).map_err(|e| format!("Cannot write log: {e}"))
}

// ---------- Helpers ----------

/// Expand a list of paths (files + folders) into a flat list of file paths.
fn expand_paths(paths: &[String]) -> Result<Vec<PathBuf>, String> {
    let mut files = Vec::new();
    for p in paths {
        let path = Path::new(p);
        if !path.exists() {
            return Err(format!("Path does not exist: {}", path.display()));
        }
        let meta = fs::symlink_metadata(path)
            .map_err(|e| format!("Cannot stat {}: {e}", path.display()))?;
        if meta.is_dir() {
            for entry in WalkDir::new(path).into_iter().filter_map(|e| e.ok()) {
                if entry.file_type().is_file() {
                    files.push(entry.path().to_path_buf());
                }
            }
        } else if meta.is_file() {
            files.push(path.to_path_buf());
        }
        // Symlinks and special files are skipped.
    }
    Ok(files)
}

/// Remove directories that are now empty after shredding their contents.
fn remove_empty_dirs(paths: &[String]) {
    // Collect all directories from the input paths, deepest first.
    let mut dirs: Vec<PathBuf> = Vec::new();
    for p in paths {
        let path = Path::new(p);
        if let Ok(meta) = fs::symlink_metadata(path) {
            if meta.is_dir() {
                // Walk and collect all subdirs.
                for entry in WalkDir::new(path).into_iter().filter_map(|e| e.ok()) {
                    if entry.file_type().is_dir() {
                        dirs.push(entry.path().to_path_buf());
                    }
                }
                dirs.push(path.to_path_buf());
            }
        }
    }
    // Sort by depth descending (deepest first) so we remove children before parents.
    dirs.sort_by(|a, b| b.components().count().cmp(&a.components().count()));
    for dir in dirs {
        let _ = fs::remove_dir(&dir); // only removes if empty
    }
}

fn drive_space(root: &str) -> Result<(u64, u64), String> {
    #[cfg(target_os = "windows")]
    {
        use std::ffi::OsStr;
        use std::os::windows::ffi::OsStrExt;
        unsafe {
            let wide: Vec<u16> = OsStr::new(root)
                .encode_wide()
                .chain(std::iter::once(0))
                .collect();
            let mut free_to_caller: u64 = 0;
            let mut total: u64 = 0;
            let mut free: u64 = 0;
            let ok = windows_sys::Win32::Storage::FileSystem::GetDiskFreeSpaceExW(
                wide.as_ptr(),
                Some(&mut free_to_caller),
                Some(&mut total),
                Some(&mut free),
            );
            if ok == 0 {
                return Err(format!("GetDiskFreeSpaceExW failed for {root}"));
            }
            Ok((total, free))
        }
    }
    #[cfg(not(target_os = "windows"))]
    {
        let _ = root;
        Ok((0, 0))
    }
}

fn volume_label(root: &str) -> Result<String, String> {
    #[cfg(target_os = "windows")]
    {
        use std::ffi::OsStr;
        use std::os::windows::ffi::OsStrExt;
        unsafe {
            let wide: Vec<u16> = OsStr::new(root)
                .encode_wide()
                .chain(std::iter::once(0))
                .collect();
            let mut name = [0u16; 256];
            let mut serial = 0u32;
            let mut max_len = 0u32;
            let mut flags = 0u32;
            let mut fs_name = [0u16; 256];
            let ok = windows_sys::Win32::Storage::FileSystem::GetVolumeInformationW(
                wide.as_ptr(),
                name.as_mut_ptr(),
                name.len() as u32,
                Some(&mut serial),
                Some(&mut max_len),
                Some(&mut flags),
                fs_name.as_mut_ptr(),
                fs_name.len() as u32,
            );
            if ok == 0 {
                return Ok(String::new());
            }
            let label = String::from_utf16_lossy(
                &name[..name.iter().position(|&c| c == 0).unwrap_or(0)],
            );
            Ok(label)
        }
    }
    #[cfg(not(target_os = "windows"))]
    {
        let _ = root;
        Ok(String::new())
    }
}

// ---------- Windows SSD detection ----------

#[cfg(target_os = "windows")]
fn detect_ssd_windows(path: &str) -> Result<bool, String> {
    use std::ffi::OsStr;
    use std::os::windows::ffi::OsStrExt;

    // Resolve the path to a drive letter (e.g. "C:").
    let drive_letter = path.chars().next().unwrap_or('C');
    let device_path = format!("\\\\.\\{}:", drive_letter);

    unsafe {
        use windows_sys::Win32::Foundation::{CloseHandle, HANDLE, INVALID_HANDLE_VALUE};
        use windows_sys::Win32::Storage::FileSystem::{
            CreateFileW, OPEN_EXISTING, FILE_SHARE_READ, FILE_SHARE_WRITE, 0 as FILE_FLAGS,
        };
        use windows_sys::Win32::System::IO::DeviceIoControl;

        let wide: Vec<u16> = OsStr::new(&device_path)
            .encode_wide()
            .chain(std::iter::once(0))
            .collect();

        let handle = CreateFileW(
            wide.as_ptr(),
            0, // no access needed for query
            FILE_SHARE_READ | FILE_SHARE_WRITE,
            std::ptr::null(),
            OPEN_EXISTING,
            FILE_FLAGS,
            std::ptr::null_mut() as HANDLE,
        );

        if handle == INVALID_HANDLE_VALUE {
            return Ok(false); // can't tell — assume not SSD
        }

        // Query storage property to get the rotation rate.
        // STORAGE_PROPERTY_QUERY: PropertyId=StorageDeviceProperty, QueryType=PropertyStandardQuery
        #[repr(C)]
        struct StoragePropertyQuery {
            property_id: u32,
            query_type: u32,
            additional_parameters: [u8; 1],
        }

        #[repr(C)]
        struct StorageDeviceDescriptor {
            version: u32,
            size: u32,
            device_type: u8,
            removable_media: u8,
            command_queueing: u8,
            vendor_id_offset: u32,
            product_id_offset: u32,
            product_revision_offset: u32,
            serial_number_offset: u32,
            bus_type: u32,
            raw_properties_length: u32,
            // raw_device_properties follows
        }

        let query = StoragePropertyQuery {
            property_id: 0, // StorageDeviceProperty
            query_type: 0, // PropertyStandardQuery
            additional_parameters: [0],
        };

        let mut out_buf = [0u8; 4096];
        let mut bytes_returned: u32 = 0;

        let ok = DeviceIoControl(
            handle as *mut _,
            0x002D1400, // IOCTL_STORAGE_QUERY_PROPERTY
            &query as *const _ as *mut _,
            std::mem::size_of::<StoragePropertyQuery>() as u32,
            out_buf.as_mut_ptr() as *mut _,
            out_buf.len() as u32,
            &mut bytes_returned,
            std::ptr::null_mut(),
        );

        CloseHandle(handle);

        if ok == 0 || bytes_returned == 0 {
            return Ok(false);
        }

        // Parse the descriptor. The rotation rate is not in the standard
        // descriptor — we need to check the bus type. SSDs typically report
        // BusTypeSata or BusTypeNvme. A simpler heuristic: check if the
        // device is removable (flash/USB) or check bus type.
        let descriptor = &*(out_buf.as_ptr() as *const StorageDeviceDescriptor);

        // BusType values (STORAGE_BUS_TYPE):
        // 0=Unknown, 1=Scsi, 2=Atapi, 3=Ata, 4=1394, 5=Ssa, 6=Fibre,
        // 7=USB, 8=RAID, 9=iScsi, 10=Sas, 11=Sata, 12=SD, 13=Mmc,
        // 14=Virtual, 15=FileBackedVirtual, 16=Spaces, 17=Nvme,
        // 18=Ufs, 19=Max
        let bus_type = descriptor.bus_type;
        // Nvme (17) and SD/MMC (12,13) are always non-rotational.
        // Sata (11) could be either — but modern SATA SSDs report
        // via the rotation rate field in a separate ATA query.
        // For simplicity: Nvme/SD/MMC/USB/1394/Virtual = SSD-like.
        let is_ssd = matches!(bus_type, 12 | 13 | 17 | 7 | 4 | 14 | 15 | 16);

        Ok(is_ssd)
    }
}
