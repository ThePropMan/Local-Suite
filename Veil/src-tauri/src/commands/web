// ============================================================
// commands/webp.rs — WebP metadata handling.
//
// WebP is a RIFF container: "RIFF" + size + "WEBP" + chunks.
// Metadata lives in "EXIF" and "XMP " chunks. VP8/VP8L/VP8X
// chunks hold the image payload and must be preserved.
//
// We walk the RIFF chunks and drop the EXIF/XMP/ANIM/ANMF
// metadata-bearing chunks, keeping the image payload verbatim.
// This is lossless — no re-encode.
// ============================================================

fn u32le(b: &[u8]) -> u32 {
    (b[0] as u32) | ((b[1] as u32) << 8) | ((b[2] as u32) << 16) | ((b[3] as u32) << 24)
}

/// Strip EXIF and XMP chunks from a WebP, losslessly.
pub fn strip_all(input: &[u8]) -> Result<Vec<u8>, String> {
    if input.len() < 12 || &input[0..4] != b"RIFF" || &input[8..12] != b"WEBP" {
        return Err("Not a WebP (bad RIFF/WEBP header)".to_string());
    }
    // RIFF header: "RIFF" + u32le total size + "WEBP".
    let total_size = u32le(&input[4..8]) as usize;
    let body_end = (12 + total_size - 4).min(input.len()); // total_size includes "WEBP"
    let mut i = 12usize;
    let mut out: Vec<u8> = Vec::with_capacity(input.len());
    // We'll rebuild the RIFF with a corrected size at the end.
    out.extend_from_slice(b"RIFF");
    out.extend_from_slice(&[0, 0, 0, 0]); // placeholder size
    out.extend_from_slice(b"WEBP");

    let mut kept_bytes = 4; // "WEBP"
    while i + 8 <= body_end {
        let ctype = &input[i..i + 4];
        let csize = u32le(&input[i + 4..i + 8]) as usize;
        let payload_start = i + 8;
        let payload_end = payload_start + csize;
        if payload_end > body_end {
            break;
        }
        // Drop EXIF, XMP, ANIM (animation metadata), ANMF (animation frame metadata).
        // Keep VP8, VP8L, VP8X, ALPH, ICCP, etc.
        let drop = ctype == b"EXIF" || ctype == b"XMP " || ctype == b"ANIM" || ctype == b"ANMF";
        if !drop {
            out.extend_from_slice(ctype);
            out.extend_from_slice(&input[i + 4..i + 8]);
            out.extend_from_slice(&input[payload_start..payload_end]);
            kept_bytes += 8 + csize;
        }
        // RIFF chunks are word-aligned: pad to even.
        let next = payload_end + (csize % 2);
        i = next;
    }

    // Patch the RIFF size.
    let riff_size = kept_bytes as u32;
    out[4..8].copy_from_slice(&riff_size.to_le_bytes());
    Ok(out)
}

/// GPS-only: same as strip_all for WebP (we can't selectively edit
/// the EXIF chunk in place without a TIFF parser; the EXIF chunk is
/// small, so dropping it entirely is the safe call). Returns the
/// input unchanged if there's no EXIF chunk.
pub fn strip_gps_only(input: &[u8]) -> Result<Vec<u8>, String> {
    if !has_exif(input) {
        return Ok(input.to_vec());
    }
    strip_all(input)
}

pub fn strip_all_keep_copyright(input: &[u8], _copyright: &str) -> Result<Vec<u8>, String> {
    // WebP doesn't have a standard copyright chunk; we'd have to write an
    // EXIF chunk back. For v1 we just strip everything.
    let _ = _copyright;
    strip_all(input)
}

pub fn has_exif(input: &[u8]) -> bool {
    if input.len() < 12 || &input[0..4] != b"RIFF" || &input[8..12] != b"WEBP" {
        return false;
    }
    let total_size = u32le(&input[4..8]) as usize;
    let body_end = (12 + total_size - 4).min(input.len());
    let mut i = 12usize;
    while i + 8 <= body_end {
        let ctype = &input[i..i + 4];
        let csize = u32le(&input[i + 4..i + 8]) as usize;
        if ctype == b"EXIF" {
            return true;
        }
        let next = i + 8 + csize + (csize % 2);
        if next <= i { break; }
        i = next;
    }
    false
}

pub fn has_xmp(input: &[u8]) -> bool {
    if input.len() < 12 || &input[0..4] != b"RIFF" || &input[8..12] != b"WEBP" {
        return false;
    }
    let total_size = u32le(&input[4..8]) as usize;
    let body_end = (12 + total_size - 4).min(input.len());
    let mut i = 12usize;
    while i + 8 <= body_end {
        let ctype = &input[i..i + 4];
        let csize = u32le(&input[i + 4..i + 8]) as usize;
        if ctype == b"XMP " {
            return true;
        }
        let next = i + 8 + csize + (csize % 2);
        if next <= i { break; }
        i = next;
    }
    false
}

/// Read the copyright field from a WebP's EXIF chunk. We delegate to
/// the JPEG TIFF parser by extracting the EXIF chunk's TIFF payload.
pub fn read_copyright(input: &[u8]) -> Option<String> {
    if input.len() < 12 || &input[0..4] != b"RIFF" || &input[8..12] != b"WEBP" {
        return None;
    }
    let total_size = u32le(&input[4..8]) as usize;
    let body_end = (12 + total_size - 4).min(input.len());
    let mut i = 12usize;
    while i + 8 <= body_end {
        let ctype = &input[i..i + 4];
        let csize = u32le(&input[i + 4..i + 8]) as usize;
        if ctype == b"EXIF" && i + 8 + csize <= body_end {
            let payload = &input[i + 8..i + 8 + csize];
            // WebP EXIF payload may start with a 4-byte "Exif\0\0"-ish header
            // or be raw TIFF. Try to find "Exif\0\0" then TIFF, else parse as TIFF.
            let tiff = if payload.len() >= 6 && &payload[0..6] == b"Exif\0\0" {
                &payload[6..]
            } else {
                payload
            };
            return read_copyright_from_tiff(tiff);
        }
        let next = i + 8 + csize + (csize % 2);
        if next <= i { break; }
        i = next;
    }
    None
}

fn read_copyright_from_tiff(tiff: &[u8]) -> Option<String> {
    let little_endian = match tiff.get(0..2) {
        Some(b"II") => true,
        Some(b"MM") => false,
        _ => return None,
    };
    let read_u16 = |b: &[u8]| -> u16 {
        if little_endian { u16::from_le_bytes([b[0], b[1]]) } else { u16::from_be_bytes([b[0], b[1]]) }
    };
    let read_u32 = |b: &[u8]| -> u32 {
        if little_endian { u32::from_le_bytes([b[0], b[1], b[2], b[3]]) } else { u32::from_be_bytes([b[0], b[1], b[2], b[3]]) }
    };
    if tiff.len() < 8 { return None; }
    let ifd0_offset = read_u32(&tiff[4..8]) as usize;
    if ifd0_offset + 2 > tiff.len() { return None; }
    let n = read_u16(&tiff[ifd0_offset..ifd0_offset + 2]) as usize;
    let entries_start = ifd0_offset + 2;
    let entries_end = entries_start + n * 12;
    if entries_end > tiff.len() { return None; }
    let copyright_tag: u16 = 0x8298;
    for i in 0..n {
        let off = entries_start + i * 12;
        let tag = read_u16(&tiff[off..off + 2]);
        if tag != copyright_tag { continue; }
        let count = read_u32(&tiff[off + 4..off + 8]) as usize;
        let value_field = &tiff[off + 8..off + 12];
        let bytes: &[u8] = if count <= 4 {
            value_field
        } else {
            let val_offset = read_u32(value_field) as usize;
            if val_offset + count > tiff.len() { return None; }
            &tiff[val_offset..val_offset + count]
        };
        let s = std::str::from_utf8(bytes).ok()?;
        return Some(s.trim_end_matches('\0').trim().to_string());
    }
    None
}
