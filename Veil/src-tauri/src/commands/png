// ============================================================
// commands/png.rs — lossless PNG chunk editor.
//
// PNG layout: 8-byte signature, then a sequence of chunks. Each
// chunk is: [length:4 BE][type:4][data:length][crc:4]. The IHDR
// chunk is always first and must be preserved. IEND terminates.
//
// Metadata chunks:
//   tEXt / zTXt / iTXt  — key/value text (often EXIF/XMP/keywords)
//   eXIf                — embedded EXIF (PNG 1.5 extension)
//   tIME                — last-modified timestamp
//   iCCP                — ICC color profile (kept — not personal)
//   sTER, sPLT, etc.    — ancillary; not personal
//
// "all" mode: drop tEXt/zTXt/iTXt/eXIf/tIME.
// "gps_only" mode: drop eXIf and any tEXt/zTXt/iTXt whose key
//                  indicates XMP/EXIF (case-insensitive substring).
// "keep_copyright": after strip_all, re-insert a single tEXt
//                  chunk with key "Copyright".
// ============================================================

const PNG_SIG: [u8; 8] = [0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A];

fn u32be(b: &[u8]) -> u32 {
    ((b[0] as u32) << 24) | ((b[1] as u32) << 16) | ((b[2] as u32) << 8) | (b[3] as u32)
}

struct Chunk {
    ctype: [u8; 4],
    data: Vec<u8>,
}

fn walk_chunks(input: &[u8]) -> Result<Vec<Chunk>, String> {
    if input.len() < 8 || input[0..8] != PNG_SIG {
        return Err("Not a PNG (bad signature)".to_string());
    }
    let mut i = 8usize;
    let mut out: Vec<Chunk> = Vec::new();
    while i + 8 <= input.len() {
        let len = u32be(&input[i..i + 4]) as usize;
        let ctype = [input[i + 4], input[i + 5], input[i + 6], input[i + 7]];
        if i + 8 + len + 4 > input.len() {
            return Err("Truncated PNG chunk".to_string());
        }
        let data = input[i + 8..i + 8 + len].to_vec();
        // CRC is at input[i+8+len..i+8+len+4]; we recompute on write so we
        // don't need to store it.
        out.push(Chunk { ctype, data });
        i += 8 + len + 4;
        if &ctype == b"IEND" {
            break;
        }
    }
    Ok(out)
}

fn crc32(data: &[u8]) -> u32 {
    // PNG uses the standard CRC-32 (IEEE 802.3, poly 0xEDB88320).
    let mut table = [0u32; 256];
    for i in 0..256u32 {
        let mut c = i;
        for _ in 0..8 {
            c = if c & 1 != 0 { 0xEDB88320 ^ (c >> 1) } else { c >> 1 };
        }
        table[i as usize] = c;
    }
    let mut crc = 0xFFFFFFFFu32;
    for &b in data {
        crc = table[((crc ^ b as u32) & 0xFF) as usize] ^ (crc >> 8);
    }
    crc ^ 0xFFFFFFFF
}

fn assemble(chunks: &[Chunk]) -> Vec<u8> {
    let mut out = Vec::with_capacity(8 + chunks.iter().map(|c| 12 + c.data.len()).sum::<usize>());
    out.extend_from_slice(&PNG_SIG);
    for c in chunks {
        out.extend_from_slice(&(c.data.len() as u32).to_be_bytes());
        out.extend_from_slice(&c.ctype);
        out.extend_from_slice(&c.data);
        // CRC covers type + data.
        let mut crc_buf = Vec::with_capacity(4 + c.data.len());
        crc_buf.extend_from_slice(&c.ctype);
        crc_buf.extend_from_slice(&c.data);
        out.extend_from_slice(&crc32(&crc_buf).to_be_bytes());
    }
    out
}

fn ctype_eq(a: &[u8; 4], b: &[u8; 4]) -> bool {
    a == b
}

/// True if a tEXt/zTXt/iTXt data block looks like XMP or EXIF.
/// Keys are case-insensitive; XMP lives under "XML:com.adobe.xmp",
/// EXIF under "Raw profile type exif" or "eXIf" (separate chunk).
fn is_metadata_text(ctype: &[u8; 4], data: &[u8]) -> bool {
    if ctype_eq(ctype, b"tEXt") || ctype_eq(ctype, b"zTXt") || ctype_eq(ctype, b"iTXt") {
        // Read the key (null-terminated for tEXt/zTXt; for iTXt it's also
        // null-terminated after the keyword).
        let key_end = data.iter().position(|&b| b == 0).unwrap_or(data.len());
        let key = String::from_utf8_lossy(&data[..key_end]).to_ascii_lowercase();
        // XMP is always metadata; "raw profile type exif" / "exif" too.
        // We treat *all* text chunks as personal metadata for the "all"
        // mode; this function is only used to decide gps-only filtering.
        key.contains("xmp") || key.contains("exif") || key.contains("raw profile type")
    } else {
        false
    }
}

/// Strip all metadata chunks from a PNG, losslessly.
pub fn strip_all(input: &[u8]) -> Result<Vec<u8>, String> {
    let chunks = walk_chunks(input)?;
    let kept: Vec<Chunk> = chunks
        .into_iter()
        .filter(|c| {
            // Keep critical chunks (uppercase first letter) and ICC profile.
            // Drop tEXt/zTXt/iTXt/eXIf/tIME.
            let t = &c.ctype;
            if ctype_eq(t, b"tEXt") || ctype_eq(t, b"zTXt") || ctype_eq(t, b"iTXt") {
                return false;
            }
            if ctype_eq(t, b"eXIf") || ctype_eq(t, b"tIME") {
                return false;
            }
            true
        })
        .collect();
    Ok(assemble(&kept))
}

/// Strip only GPS-bearing chunks from a PNG. Drops eXIf and any
/// text chunk that carries XMP/EXIF. Other text chunks (e.g. a
/// custom "Comment" field) are left intact.
pub fn strip_gps_only(input: &[u8]) -> Result<Vec<u8>, String> {
    let chunks = walk_chunks(input)?;
    let mut changed = false;
    let kept: Vec<Chunk> = chunks
        .into_iter()
        .filter(|c| {
            let t = &c.ctype;
            if ctype_eq(t, b"eXIf") {
                changed = true;
                return false;
            }
            if (ctype_eq(t, b"tEXt") || ctype_eq(t, b"zTXt") || ctype_eq(t, b"iTXt"))
                && is_metadata_text(t, &c.data)
            {
                changed = true;
                return false;
            }
            true
        })
        .collect();
    if !changed {
        return Ok(input.to_vec());
    }
    Ok(assemble(&kept))
}

/// Strip all metadata then re-insert a single tEXt chunk with the
/// copyright string. If empty, behaves like `strip_all`.
pub fn strip_all_keep_copyright(input: &[u8], copyright: &str) -> Result<Vec<u8>, String> {
    let mut stripped = strip_all(input)?;
    if copyright.is_empty() {
        return Ok(stripped);
    }
    // Build a tEXt chunk: "Copyright\0<value>".
    let mut data = Vec::with_capacity(9 + 1 + copyright.len());
    data.extend_from_slice(b"Copyright");
    data.push(0);
    data.extend_from_slice(copyright.as_bytes());
    let chunk = Chunk { ctype: *b"tEXt", data };
    // Insert after IHDR (which is always first).
    let mut chunks = walk_chunks(&stripped)?;
    chunks.insert(1.min(chunks.len()), chunk);
    stripped = assemble(&chunks);
    Ok(stripped)
}

/// Read the Copyright tEXt chunk from a PNG, if present.
pub fn read_copyright(input: &[u8]) -> Option<String> {
    let chunks = walk_chunks(input).ok()?;
    for c in chunks {
        if !ctype_eq(&c.ctype, b"tEXt") {
            continue;
        }
        let key_end = c.data.iter().position(|&b| b == 0)?;
        let key = String::from_utf8_lossy(&c.data[..key_end]).to_string();
        if key.eq_ignore_ascii_case("copyright") {
            let value = String::from_utf8_lossy(&c.data[key_end + 1..]).to_string();
            return Some(value.trim().to_string());
        }
    }
    None
}

pub fn has_exif(input: &[u8]) -> bool {
    if let Ok(chunks) = walk_chunks(input) {
        chunks.iter().any(|c| ctype_eq(&c.ctype, b"eXIf"))
    } else {
        false
    }
}

pub fn has_xmp(input: &[u8]) -> bool {
    if let Ok(chunks) = walk_chunks(input) {
        chunks.iter().any(|c| {
            (ctype_eq(&c.ctype, b"tEXt") || ctype_eq(&c.ctype, b"zTXt") || ctype_eq(&c.ctype, b"iTXt"))
                && is_metadata_text(&c.ctype, &c.data)
        })
    } else {
        false
    }
}
